# Server Configuration
PORT=3000
NODE_ENV=development

# Security Configuration
MAX_PRICE_AGE_MINUTES=5
MIN_PRICE_AGE_MINUTES=1
MAX_PRICE_DEVIATION=0.1
MAX_BORROW_UTILIZATION=0.8
MIN_COLLATERAL_RATIO=1.5
MAX_SINGLE_BORROW_AMOUNT=1000000
SUSPICIOUS_AMOUNT_THRESHOLD=500000
FLASH_LOAN_DETECTION_WINDOW=1
PRICE_ANOMALY_THRESHOLD=0.05

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# API Configuration
API_RATE_LIMIT=100
API_RATE_LIMIT_WINDOW=900000 